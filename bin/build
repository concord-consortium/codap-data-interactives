#!/usr/bin/env bash
#
# Assembles built images of standard plugins whether local to this repo or in another repo.
#
# Creates a zip file, "codap-data-interactives-{build-num}.zip" in target
# containing self-contained versions of each endorsed plugin.
#
PROGNAME=`basename $0`
DIRNAME=`dirname $0`
HOMEDIR="$DIRNAME/.."

# make sure we are in the root directory of the plugin folder
cd "$HOMEDIR" || exit

# Set env
TARGET="$PWD/target" # Where to put zip.
WORKING="$TARGET/build"
BUILD_NUM=`cat lib/build-num.txt`
BUILD_DIR="$WORKING/plugins"
ZIP_FILENAME=codap-data-interactives-${BUILD_NUM}.zip

# NOTE: The eepsmedia plugins (Choosy, scrambler, simmer, testimate) moved to
# https://github.com/concord-consortium/eepsmedia on 2026-07-31 (CODAP-1423) and are no longer
# copied by this build. They are still listed in published-plugins.json because that file describes
# what a V2 build should contain, so a V2 build needs them copied in by hand.
#
# WHERE that manual copy has to happen is not obvious -- see warnEepsmediaNotBuilt() below, which
# prints the instructions at the end of every run.
STATIC_PLUGIN_DIRS="TP-Sampler DrawTool Importer NOAA-weather sdlc/plugin Sonify
data-science-worlds/nhanes"
HIDDEN_DIRS="Common"
BUILT_PLUGIN_DIRS="onboarding
                   ../codap-transformers
                   ../story-builder
                   ../noaa-codap-plugin"
COPIED_DIRS="$STATIC_PLUGIN_DIRS $HIDDEN_DIRS"
ALL_DIRS="$BUILT_PLUGIN_DIRS $COPIED_DIRS"

PLUGIN_MAP_FILE="${HOMEDIR}/data_interactive_map.json"
PUBLISHED_PLUGIN_MAP_FILE=published-plugins.json

JSON_PARSER=./node_modules/node-jq/bin/jq

function makeIndexJSON() {
  tmp=
  for t in "$@"; do
    [ "$tmp" != "" ] && tmp="$tmp,"
    tmp="$tmp\"/$t\""
  done
  # echo tmp=$tmp
  cat $PLUGIN_MAP_FILE |
#    $JSON_PARSER --argjson paths "[$tmp]" '[$paths[] as $t | .data_interactives[] | select(.path|startswith($t))]' > ${PUBLISHED_PLUGIN_MAP_FILE}
    $JSON_PARSER '[.data_interactives[] | select(.isStandard=="true")]' > ${PUBLISHED_PLUGIN_MAP_FILE}
}

function echoPlugins() {
  echo "Plugins:"
  for plugin in "$@"; do
    echo "  $plugin";
  done
}

function buildPlugins() {
  FAILED_PLUGINS=""
  for plugin in "$@"; do
    PLUGIN_BUILD_DIR=build
    PLUGIN_NAME=$(basename $plugin)
    if [ "$plugin" == "onboarding" ] ; then
      PLUGIN_BUILD_DIR=target
    fi
    echo Building $plugin
    if [ "$plugin" == "../noaa-codap-plugin" ] ; then
      ( cd $plugin && npm ci && npm run build && cp -r "dist" "$BUILD_DIR/$PLUGIN_NAME" )
    else
      ( cd $plugin && npm ci && npm run build && cp -r $PLUGIN_BUILD_DIR "$BUILD_DIR/$PLUGIN_NAME" )
    fi
    if [ $? -ne 0 ] ; then
      echo "${PROGNAME}: ERROR - Failed to build $plugin" 1>&2
      FAILED_PLUGINS="$FAILED_PLUGINS $plugin"
    fi
  done
  if [ -n "$FAILED_PLUGINS" ] ; then
    echo "${PROGNAME}: ERROR - The following plugins failed to build:$FAILED_PLUGINS" 1>&2
  fi
}

function copyStaticPlugins() {
  for t in "$@"; do
    mkdir -p "${BUILD_DIR}/${t}"
    rsync -av --exclude=node_modules/ --exclude=.idea/ "${t}/" "${BUILD_DIR}/${t}"
  done
}

# The eepsmedia plugins are listed in published-plugins.json but are no longer produced by this
# build, so a V2 build assembled from it will offer four plugins whose folders are absent. Nothing
# fails loudly when that happens -- the plugins just 404 from CODAP's plugin menu -- so say so here.
function warnEepsmediaNotBuilt() {
  cat 1>&2 <<'EOF'

################################################################################
##                                                                            ##
##   WARNING: THE eepsmedia PLUGINS WERE NOT BUILT                            ##
##            A V2 BUILD REQUIRES MANUAL INTERVENTION                         ##
##                                                                            ##
################################################################################

  Choosy, scrambler, simmer and testimate moved to
  https://github.com/concord-consortium/eepsmedia on 2026-07-31 (CODAP-1423).
  They are still listed in published-plugins.json, because that file describes
  what a V2 build SHOULD contain -- but this script no longer produces them.

  Ship a V2 build as-is and those four plugins 404 from CODAP's plugin menu.

  TO FIX (recommended): copy them on the server AFTER the build is deployed,
  the same way the codap-v2-build skill recovers any other missing plugin:

      ssh codap-server.concord.org \
        "sudo cp -r /var/www/html/releases/build_PREV/extn/plugins/eepsmedia \
                    /var/www/html/releases/build_NEW/extn/plugins/eepsmedia"

  See Phase 3, Step 8 of the codap-v2-build skill in the codap repo.

  ALTERNATIVE (local, harder): copy into <build>/extn/plugins/eepsmedia/ AFTER
  codap/bin/makeExtn finishes and BEFORE the zip is sealed. That window is
  narrow because neither earlier destination survives:

    - makeExtn rsyncs into extn/plugins with --delete, which removes anything
      you pre-placed there;
    - this script does rm -rf on its working dir, so pre-placing the folders in
      target/build/plugins does not survive either.

  Either way, the source is the previous build or
  s3://codap-resources/plugins/eepsmedia/, and the layout to reproduce mirrors
  the eepsmedia repo root:

      extn/plugins/eepsmedia/common/
      extn/plugins/eepsmedia/plugins/{Choosy,scrambler,simmer,testimate}/

  Note the capital C in Choosy -- it is case-sensitive on Linux.

  See eepsmedia/README.md in this repo for the full rationale.

################################################################################

EOF
}

function usage() {
  echo usage $PROGNAME 1>&2
}

function error() {
  echo ${PROGNAME}: error - "$@" 1>&2
  exit 1
}

# check for needed programs
which -s $JSON_PARSER || error "Please install $JSON_PARSER."

mkdir -p "$TARGET"
mkdir -p "$BUILD_DIR"
rm -rf "$WORKING"
mkdir -p "$WORKING/plugins"
echo "Build: $BUILD_NUM"
echoPlugins $ALL_DIRS
copyStaticPlugins $COPIED_DIRS
buildPlugins $BUILT_PLUGIN_DIRS
makeIndexJSON $ALL_DIRS
cp "$PUBLISHED_PLUGIN_MAP_FILE" "$BUILD_DIR"

 ( cd "$WORKING" ; zip -rq "$TARGET/$ZIP_FILENAME" plugins )

# Last thing printed, so it is still on screen when the build finishes.
warnEepsmediaNotBuilt
#rm $BUILD_DIR
#rm $PUBLISHED_PLUGIN_MAP_FILE
